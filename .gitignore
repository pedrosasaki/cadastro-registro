# ============================================================
# .gitignore — arquivos que NUNCA devem ir para o GitHub
# ------------------------------------------------------------
# Este arquivo diz ao Git (e ao GitHub) quais arquivos devem
# ser ignorados no upload. Segredos e configurações locais
# ficam de fora; só o código vai para o repositório.
# ============================================================

# ---------- SEGREDOS E CONFIGURAÇÕES LOCAIS ----------
# O arquivo .env contém suas chaves reais — nunca enviar!
.env
*.env
!.env.example

# Arquivo de segredos do Streamlit (teste local)
.streamlit/secrets.toml

# ---------- PYTHON ----------
# Pasta com código "compilado" temporário
__pycache__/
*.py[cod]

# Ambientes virtuais (instalações locais do Python)
.venv/
venv/
env/
ENV/

# ---------- SISTEMA OPERACIONAL ----------
.DS_Store
Thumbs.db

# ---------- EDITORES / IDE ----------
.vscode/
.idea/

# ---------- RELATÓRIOS E SOBRAS ----------
*.log
