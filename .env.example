# ============================================================
# .env.example — MODELO das variáveis de ambiente
# ------------------------------------------------------------
# Este arquivo NÃO contém segredos reais: ele serve apenas
# para mostrar QUAIS variáveis o aplicativo precisa.
#
# COMO USAR (teste no seu computador):
#   1. Copie este arquivo e renomeie a cópia para ".env"
#   2. Preencha os valores reais (sem os colchetes)
#   3. Pronto: o aplicativo lê daqui AO RODAR LOCALMENTE
#
# ⚠️ O arquivo .env com os valores reais está no .gitignore:
#    ele NUNCA deve ser enviado ao GitHub.
#
# No STREAMLIT COMMUNITY CLOUD (publicação final), as mesmas
# variáveis são informadas no painel da plataforma, em
# "Settings -> Secrets" (não existe arquivo .env lá).
# ============================================================

# ---------- SUPABASE ----------
# URL do seu projeto Supabase (campo "Project URL")
# Onde encontrar: painel do Supabase -> Settings -> API
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública do projeto (campo "anon public key" — começa com eyJ...)
# Onde encontrar: painel do Supabase -> Settings -> API
# ⚠️ É a ANON, jamais a service_role (chave-mestra)
SUPABASE_ANON_KEY=eyJ...SUA-CHAVE-ANONIMA...

# ---------- APP ----------
# Senha do "crachá" — a MESMA que você usou no script SQL,
# no lugar de <SUA_SENHA_FORTE>.
# O aplicativo envia essa senha em um cabeçalho seguro para
# o Supabase autorizar a gravação e a consulta.
APP_KEY=SUA-SENHA-ESCOLHIDA-NO-SQL

# (OPCIONAL) Senha para PROTEGER a página de Consulta.
# Se informada, quem abrir a consulta precisa digitá-la.
# Se deixar vazia, a consulta fica aberta para quem tiver o link.
CONSULTA_PASSWORD=
